# Required only for AI editorial generation.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini

# Keep review mode until the first 20 posts have been checked manually.
FOODWORLD_APPROVAL_MODE=review
FOODWORLD_PUBLISH_ENABLED=false
FOODWORLD_TIMEZONE=Asia/Ho_Chi_Minh
FOODWORLD_APPROVER=Kim

# Facebook Page Reels
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_MODE=inbox
TIKTOK_DIRECT_POST_APPROVED=false
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# YouTube Data API OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
